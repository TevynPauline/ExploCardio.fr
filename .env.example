# ExploCardio.fr — variables d'environnement
# Copiez ce fichier en .env.local et complétez-le. Ne versionnez JAMAIS de valeur réelle.
# En mode démonstration, aucune clé de service réel n'est nécessaire.

# Mode du site : demo (site de démonstration protégé) ou prod
SITE_MODE=demo

# Mode de chaque connecteur : demo (par défaut) ou real
CONNECTOR_ODOO=demo
CONNECTOR_STRIPE=demo
CONNECTOR_PCA=demo
CONNECTOR_EMAILING=demo

# Sous-mode du connecteur PCA de démonstration : auto ou manual
PCA_DEMO_SUBMODE=auto

# Bases de données PostgreSQL
DATABASE_URL=
DEMO_DATABASE_URL=

# Secret de signature des sessions (chaîne aléatoire d'au moins 32 caractères)
AUTH_SECRET=

# Site de démonstration : mot de passe d'accès initial, et identifiants communs des cinq
# comptes de démonstration (stables d'une réinitialisation à l'autre). Générés si absents.
DEMO_SITE_PASSWORD=
DEMO_ACCOUNTS_PASSWORD=
DEMO_TOTP_SECRET=

# Adresse publique du site (ex. http://localhost:3000)
SITE_URL=http://localhost:3000

# --- Mode réel uniquement (phase 2, F14) ---
