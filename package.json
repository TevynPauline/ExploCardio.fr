{
  "name": "explocardio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/postdeploy.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "test:no-egress": "playwright test tests/e2e/no-egress.spec.ts",
    "test:lighthouse": "tsx scripts/lighthouse.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "db:generate": "prisma generate --config prisma/site/prisma.config.ts && prisma generate --config prisma/demo/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma/site/prisma.config.ts && prisma migrate dev --config prisma/demo/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma/site/prisma.config.ts && prisma migrate deploy --config prisma/demo/prisma.config.ts",
    "demo:seed": "tsx prisma/demo/seed/index.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "postinstall": "npm run db:generate",
    "demo:cle-2fa": "tsx scripts/cle-double-authentification.ts",
    "odoo:sonder": "tsx scripts/sonder-odoo.ts"
  },
  "dependencies": {
    "@better-auth/utils": "0.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "better-auth": "1.7.10",
    "isomorphic-dompurify": "4.5.0",
    "marked": "18.1.1",
    "next": "16.4.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "prisma": "7.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/inter": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false
  }
}
