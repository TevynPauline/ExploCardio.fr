// Base de démonstration ExploCardio.fr — data-model.md §2 (F11).
// Équivalent FICTIF d'Odoo, utilisé seulement par les connecteurs en mode démonstration.
// Vocabulaire d'Odoo entre parenthèses (FR-012). Montants en centimes d'euro, HT sauf mention.
// Chaque objet porte « estFictif » (toujours vrai) : les implémentations réelles le refusent (FR-017).
// Ni garanties ni demandes de SAV (FR-010). Aucune donnée de patient (FR-039).

generator client {
  provider = "prisma-client"
  output   = "../../generated/demo"
}

datasource db {
  provider = "postgresql"
}

/// Partenaire (res.partner) : médecin ou cabinet fictif.
model Partenaire {
  id             Int          @id @default(autoincrement())
  /// Référence stable exposée par le connecteur (équivalent de l'identifiant Odoo).
  ref            String       @unique
  nom            String
  estSociete     Boolean      @default(false)
  parentId       Int?
  parent         Partenaire?  @relation("SocieteParente", fields: [parentId], references: [id])
  membres        Partenaire[] @relation("SocieteParente")
  email          String?
  telephone      String?
  rpps           String?      @unique
  siret          String?
  adresses       Json         @default("[]")
  /// Clé d'idempotence de création (créer ou retrouver sans doublon).
  cleCreation    String?      @unique
  /// A bénéficié de l'offre de bienvenue (F02).
  bienvenueRecue Boolean      @default(false)
  /// Partenaire archivé (suppression du compte sur le site) : factures conservées (F02).
  archive        Boolean      @default(false)
  estFictif      Boolean      @default(true)

  commandes     CommandeVente[]
  abonnements   Abonnement[]
  factures      Facture[]
  mouvements    MouvementCagnotte[]
  kits          KitPossede[]
  lotsBons      LotBons[]
  interventions InterventionPayee[]
  droits        DroitAssistance?
  listesPrix    ListePrix[]
  opportunites  Opportunite[]
  accesCloud    AccesCloud[]
  compteCloud   CompteCloud?

  @@map("res_partner")
}

/// Catégorie (product.category).
model Categorie {
  id        Int             @id @default(autoincrement())
  code      String          @unique
  nom       String
  ordre     Int             @default(0)
  parentId  Int?
  parent    Categorie?      @relation("CategorieParente", fields: [parentId], references: [id])
  enfants   Categorie[]     @relation("CategorieParente")
  modeles   ModeleArticle[]
  estFictif Boolean         @default(true)

  @@map("product_category")
}

enum TypeArticle {
  equipement
  consommable
  accessoire
  logiciel
  service
}

/// Modèle d'article (product.template).
model ModeleArticle {
  id                Int         @id @default(autoincrement())
  nom               String
  marque            String
  categorieId       Int
  categorie         Categorie   @relation(fields: [categorieId], references: [id])
  type              TypeArticle
  description       String?
  /// Formules proposées : achat, mise_a_disposition, financement.
  formules          String[]
  eligibleBonsAchat Boolean     @default(false)
  suiviNumeroSerie  Boolean     @default(false)
  /// Référence fictive signalée (aucune référence fabricant connue).
  referenceFictive  Boolean     @default(false)
  /// Compatibilités : default_code des équipements compatibles (consommables, accessoires).
  compatibleAvec    String[]    @default([])
  estFictif         Boolean     @default(true)
  variantes         Variante[]

  @@map("product_template")
}

/// Variante (product.product).
model Variante {
  id                        Int           @id @default(autoincrement())
  modeleId                  Int
  modele                    ModeleArticle @relation(fields: [modeleId], references: [id], onDelete: Cascade)
  /// Référence interne (default_code), fixe d'un remplissage à l'autre.
  defaultCode               String        @unique
  referenceFabricant        String?
  /// Libellé de la configuration (ex. « 26-34 cm »).
  configuration             String?
  attributs                 Json          @default("{}")
  prixHtCentimes            Int
  /// F12 : logiciel Cloud inclus à l'achat de cette configuration (default_code) et durée
  /// de la période incluse en mois (12 par défaut, FR-006).
  logicielInclus            String?
  moisInclus                Int?
  tauxTva                   Decimal       @default(20) @db.Decimal(5, 2)
  /// Unités par conditionnement (product.packaging) : 50 pour une boîte de 50 (F03).
  quantiteParLot            Int           @default(1)
  /// Frais de livraison et d'installation propres à un équipement volumineux (F04, FR-046).
  fraisLivraisonCentimes    Int?
  fraisInstallationCentimes Int?
  /// Variantes qui composent un pack (nomenclature « kit », mrp.bom) (F03).
  composants                String[]      @default([])
  /// Prix inventé, à remplacer avant toute présentation à un médecin (décision D6).
  prixInvente               Boolean       @default(true)
  estFictif                 Boolean       @default(true)

  stock        Stock?
  numerosSerie NumeroSerie[]
  offreMad     OffreMiseADisposition?
  lignes       LigneCommande[]
  abonnements  Abonnement[]

  @@map("product_product")
}

enum EtatStock {
  disponible
  delai
  indisponible
}

/// Stock (stock.quant).
model Stock {
  id            Int       @id @default(autoincrement())
  varianteId    Int       @unique
  variante      Variante  @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  quantite      Int       @default(0)
  /// État quand la quantité est épuisée : délai X jours ou indisponible.
  etatHorsStock EtatStock @default(delai)
  delaiJours    Int?
  estFictif     Boolean   @default(true)

  @@map("stock_quant")
}

/// Réservation de stock (stock.move), idempotente par clé.
model Reservation {
  id          Int      @id @default(autoincrement())
  cle         String
  defaultCode String
  quantite    Int
  creeLe      DateTime @default(now())

  @@unique([cle, defaultCode])
  @@map("stock_move")
}

enum StatutParc {
  disponible
  loue
  en_retour
  en_maintenance
}

/// Numéro de série (stock.lot) : parc de location.
model NumeroSerie {
  id           Int                   @id @default(autoincrement())
  varianteId   Int
  variante     Variante              @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  numero       String                @unique
  statut       StatutParc            @default(disponible)
  /// Date prévue de retour au parc (pour la première date de livraison possible).
  retourPrevu  DateTime?
  /// Affectations, retours et interventions (F05).
  historique   Json                  @default("[]")
  estFictif    Boolean               @default(true)
  abonnements  Abonnement[]
  reservations ReservationAppareil[]

  @@map("stock_lot")
}

enum EtatReservationAppareil {
  active
  consommee
  liberee
}

/// Réservation d'un appareil du parc avant le paiement d'une mise à disposition (F05, R4).
model ReservationAppareil {
  id            Int                     @id @default(autoincrement())
  cle           String                  @unique
  numeroSerieId Int
  numeroSerie   NumeroSerie             @relation(fields: [numeroSerieId], references: [id], onDelete: Cascade)
  dateLivraison DateTime
  /// Statut de l'appareil avant la réservation (rétabli si elle est libérée).
  statutAvant   StatutParc              @default(disponible)
  etat          EtatReservationAppareil @default(active)
  creeLe        DateTime                @default(now())

  @@map("stock_lot_reservation")
}

/// Liste de prix (product.pricelist) : prix par client, mensualités forcées (F03).
model ListePrix {
  id           Int         @id @default(autoincrement())
  nom          String
  partenaireId Int?
  partenaire   Partenaire? @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  /// Règles : [{ defaultCode, prixHtCentimes?, remisePourcent?, quantiteMin?, dureeMois?, mensualiteCentimes? }]
  /// Sans partenaire : liste publique (paliers dégressifs, mensualités forcées pour tous).
  regles       Json
  estFictif    Boolean     @default(true)

  @@map("product_pricelist")
}

/// Barème de financement : paramètre commercial (principe VI).
model BaremeFinancement {
  id          Int     @id @default(autoincrement())
  dureeMois   Int     @unique
  /// Coefficient mensuel en pourcentage du montant financé (ex. 3,05).
  coefficient Decimal @db.Decimal(6, 3)
  estFictif   Boolean @default(true)

  @@map("financing_scale")
}

/// Offre de mise à disposition (F05) : paramètres commerciaux.
model OffreMiseADisposition {
  id                         Int      @id @default(autoincrement())
  varianteId                 Int      @unique
  variante                   Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  premierMoisCentimes        Int
  moisSuivantsCentimes       Int
  /// default_code du kit de consommables requis à la première commande, s'il existe.
  kitRequis                  String?
  valeurRemplacementCentimes Int
  /// Logiciel Cloud ouvert à l'expédition (F05, FR-012) et contenu du pack affiché (FR-001).
  logiciel                   String?
  contenuPack                String[] @default([])
  estFictif                  Boolean  @default(true)

  @@map("rental_offer")
}

enum StatutCommande {
  brouillon
  /// Ancien statut « payée » (F11) ; lu comme « payee ».
  confirmee
  en_attente_paiement
  payee
  en_preparation
  expediee
  livree
  annulee
  remboursee_partiellement
  remboursee
}

/// Commande de vente (sale.order).
model CommandeVente {
  id                    Int                @id @default(autoincrement())
  ref                   String             @unique
  cle                   String?            @unique
  partenaireId          Int
  partenaire            Partenaire         @relation(fields: [partenaireId], references: [id])
  date                  DateTime           @default(now())
  montantHtCentimes     Int
  tvaCentimes           Int
  montantTtcCentimes    Int
  fraisPortCentimes     Int                @default(0)
  bonsUtilisesCentimes  Int                @default(0)
  modePaiement          String
  referencePaiement     String?
  statut                StatutCommande     @default(confirmee)
  financee              Boolean            @default(false)
  livraison             Json               @default("{}")
  /// Transporteur et numéro de suivi (F04).
  transporteur          String?
  suivi                 String?
  /// Fin de la réservation d'une commande à régler par virement (F04).
  echeancePaiement      DateTime?
  modifieLe             DateTime           @default(now()) @updatedAt
  remboursements        Remboursement[]
  locations             Abonnement[]
  /// F06 : règles du programme figées au paiement (taux, palier, validité, seuil et durée des droits).
  reglesFidelite        Json?
  /// F06 : bons déjà dépensés à retirer, déduits d'un remboursement (D4).
  bonsManquantsCentimes Int                @default(0)
  /// F06 : code promo appliqué (limites d'usage par client).
  codePromo             String?
  lotsBons              LotBons[]
  intervention          InterventionPayee?
  estFictif             Boolean            @default(true)

  lignes     LigneCommande[]
  factures   Facture[]
  mouvements MouvementCagnotte[]

  @@map("sale_order")
}

/// Mode de livraison (delivery.carrier) : forfait, délai, actif (F04).
model ModeLivraison {
  id              Int     @id @default(autoincrement())
  code            String  @unique
  libelle         String
  forfaitCentimes Int
  delaiJours      Int
  /// Proposé seulement si tous les articles sont en stock (express).
  exigeStock      Boolean @default(false)
  /// Le franco de port s'applique à ce mode.
  franco          Boolean @default(true)
  actif           Boolean @default(true)
  ordre           Int     @default(0)
  estFictif       Boolean @default(true)

  @@map("delivery_carrier")
}

/// Paramètres de vente (F04) : seuil de franco, délai de réservation d'un virement.
model ParametresVente {
  id                  Int     @id @default(autoincrement())
  seuilFrancoCentimes Int
  delaiVirementJours  Int     @default(7)
  estFictif           Boolean @default(true)

  @@map("sale_settings")
}

/// Règles de location (F05, principe VI) : impayés, retours, tolérance, non-retour (D7).
model ReglesLocation {
  id                        Int     @id @default(autoincrement())
  tentativesPrelevement     Int     @default(3)
  espacementTentativesJours Int     @default(3)
  delaiRegularisationJours  Int     @default(10)
  delaiRetourJoursOuvres    Int     @default(5)
  toleranceRetardJours      Int     @default(5)
  delaiNonRetourJours       Int     @default(30)
  estFictif                 Boolean @default(true)

  @@map("rental_settings")
}

enum OrigineKit {
  achat
  enregistrement
}

/// Kit d'accessoires possédé par un client (F05, FR-016).
model KitPossede {
  id             Int        @id @default(autoincrement())
  partenaireId   Int
  partenaire     Partenaire @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  kitDefaultCode String
  origine        OrigineKit
  commandeId     Int?
  auteur         String?
  creeLe         DateTime   @default(now())

  @@unique([partenaireId, kitDefaultCode])
  @@map("res_partner_kit")
}

enum EtatRemboursement {
  a_executer
  execute
}

/// Remboursement (account.payment de remboursement) : décidé dans Odoo ou fait dans Stripe (F04).
model Remboursement {
  id                    Int               @id @default(autoincrement())
  commandeId            Int
  commande              CommandeVente     @relation(fields: [commandeId], references: [id])
  montantTtcCentimes    Int
  /// F06 (D4) : bons d'achat déjà dépensés déduits de ce remboursement, en HT et TTC.
  bonsDeduitsHtCentimes Int               @default(0)
  deductionTtcCentimes  Int               @default(0)
  motif                 String
  /// odoo (décidé par l'équipe) ou stripe (fait directement dans Stripe)
  source                String
  etat                  EtatRemboursement @default(a_executer)
  referenceStripe       String?
  /// Clé d'idempotence de l'enregistrement.
  cle                   String?           @unique
  avoirNumero           String?
  creeLe                DateTime          @default(now())
  estFictif             Boolean           @default(true)

  @@map("account_refund")
}

/// Ligne de commande (sale.order.line).
model LigneCommande {
  id                     Int           @id @default(autoincrement())
  commandeId             Int
  commande               CommandeVente @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  varianteId             Int
  variante               Variante      @relation(fields: [varianteId], references: [id])
  quantite               Int
  prixUnitaireHtCentimes Int
  remiseCentimes         Int           @default(0)

  @@map("sale_order_line")
}

enum ObjetAbonnement {
  mise_a_disposition
  logiciel
}

enum EtatAbonnement {
  commandee
  en_cours
  resiliation_prevue
  en_retard_retour
  suspendue_impaye
  terminee
  annulee
}

enum EtatRetour {
  complet
  degrade
  perdu
}

/// Abonnement (sale.order récurrente) : location ou abonnement logiciel (F05, F12).
model Abonnement {
  id                         Int             @id @default(autoincrement())
  ref                        String          @unique
  cle                        String?         @unique
  partenaireId               Int
  partenaire                 Partenaire      @relation(fields: [partenaireId], references: [id])
  objet                      ObjetAbonnement
  varianteId                 Int
  variante                   Variante        @relation(fields: [varianteId], references: [id])
  numeroSerieId              Int?
  numeroSerie                NumeroSerie?    @relation(fields: [numeroSerieId], references: [id])
  montantMensuelCentimes     Int
  debut                      DateTime
  fin                        DateTime?
  prochaineEcheance          DateTime?
  etat                       EtatAbonnement  @default(en_cours)
  /// F05 : date de livraison annoncée, retour, expédition, impayé, retour constaté.
  dateLivraison              DateTime?
  dateLimiteRetour           DateTime?
  commandeId                 Int?
  commande                   CommandeVente?  @relation(fields: [commandeId], references: [id])
  expeditionBloquee          Boolean         @default(false)
  transporteur               String?
  suivi                      String?
  expedieLe                  DateTime?
  attenteChoixClient         Boolean         @default(false)
  colisNonLivre              Boolean         @default(false)
  impayeDepuis               DateTime?
  tentativesPrelevement      Int             @default(0)
  rappelsRetour              Int             @default(0)
  etatRetour                 EtatRetour?
  montantDegradationCentimes Int?
  modifieLe                  DateTime        @default(now()) @updatedAt
  estFictif                  Boolean         @default(true)

  @@map("sale_subscription")
}

enum TypeFacture {
  facture
  remboursement
}

/// Facture (account.move) ; les avoirs sont du type « remboursement ».
model Facture {
  id                 Int            @id @default(autoincrement())
  /// Numéro continu (ex. FICT/2026/00001).
  numero             String         @unique
  type               TypeFacture    @default(facture)
  partenaireId       Int
  partenaire         Partenaire     @relation(fields: [partenaireId], references: [id])
  commandeId         Int?
  commande           CommandeVente? @relation(fields: [commandeId], references: [id])
  date               DateTime       @default(now())
  montantHtCentimes  Int
  tvaCentimes        Int
  montantTtcCentimes Int
  etatPaiement       String         @default("paye")
  lignes             Json           @default("[]")
  /// Clé d'idempotence d'une facture d'échéance (F04).
  cle                String?        @unique
  estFictif          Boolean        @default(true)

  @@map("account_move")
}

/// Programme de fidélité (loyalty.program) : règles de F06, une seule ligne active.
model ProgrammeFidelite {
  id           Int     @id @default(autoincrement())
  /// Paliers : [{ plancherCentimes, inclusif, tauxPourcent }] (défaut 0 % / 5 % dès 500 € / 10 % au-delà de 1 000 €).
  paliers      Json
  validiteMois Int     @default(12)
  estFictif    Boolean @default(true)

  @@map("loyalty_program")
}

/// Règles des droits d'assistance (F06) : seuil, durée, prolongation, plafond.
model RegleAssistance {
  id               Int     @id @default(autoincrement())
  seuilCentimes    Int
  dureeJours       Int
  /// cumul (la durée s'ajoute) ou remise_a_zero (la durée repart de la commande).
  prolongation     String  @default("cumul")
  plafondJours     Int
  prixActeCentimes Int
  estFictif        Boolean @default(true)

  @@map("assistance_rule")
}

/// Mouvement de cagnotte (loyalty.card + historique). Le solde est la somme des mouvements.
model MouvementCagnotte {
  id              Int            @id @default(autoincrement())
  partenaireId    Int
  partenaire      Partenaire     @relation(fields: [partenaireId], references: [id])
  /// credit, utilisation, retrait, restitution, expiration
  type            String
  montantCentimes Int
  commandeId      Int?
  commande        CommandeVente? @relation(fields: [commandeId], references: [id])
  /// Évite de compter deux fois un même événement (F06, FR-018).
  cle             String         @unique
  date            DateTime       @default(now())
  validiteFin     DateTime?
  /// F06 : lot de bons crédité, consommé ou rendu ; règles appliquées ; motif et auteur d'un ajustement.
  lotId           Int?
  lot             LotBons?       @relation(fields: [lotId], references: [id])
  regles          Json?
  motif           String?
  auteur          String?
  estFictif       Boolean        @default(true)

  @@map("loyalty_history")
}

/// Lot de bons d'achat (F06, R3) : un crédit, une restitution ou un ajustement positif, avec sa
/// date de fin de validité ; consommé dans l'ordre des fins de validité.
model LotBons {
  id                     Int                 @id @default(autoincrement())
  partenaireId           Int
  partenaire             Partenaire          @relation(fields: [partenaireId], references: [id])
  /// credit, restitution, ajustement
  origine                String
  montantInitialCentimes Int
  resteCentimes          Int
  validiteFin            DateTime
  commandeId             Int?
  commande               CommandeVente?      @relation(fields: [commandeId], references: [id])
  creeLe                 DateTime            @default(now())
  mouvements             MouvementCagnotte[]
  estFictif              Boolean             @default(true)

  @@index([partenaireId, validiteFin])
  @@map("loyalty_lot")
}

enum EtatIntervention {
  disponible
  consommee
}

/// Intervention d'assistance payée à l'acte (F06, FR-038).
model InterventionPayee {
  id           Int              @id @default(autoincrement())
  partenaireId Int
  partenaire   Partenaire       @relation(fields: [partenaireId], references: [id])
  commandeId   Int              @unique
  commande     CommandeVente    @relation(fields: [commandeId], references: [id])
  etat         EtatIntervention @default(disponible)
  acheteeLe    DateTime         @default(now())
  consommeeLe  DateTime?
  auteur       String?
  modifieLe    DateTime         @default(now()) @updatedAt
  estFictif    Boolean          @default(true)

  @@map("assistance_ticket")
}

/// Droits d'assistance d'un partenaire (spécifique ; à reproduire dans Odoo en phase 2).
model DroitAssistance {
  id           Int        @id @default(autoincrement())
  partenaireId Int        @unique
  partenaire   Partenaire @relation(fields: [partenaireId], references: [id])
  fin          DateTime
  /// Commande ou origine de la période.
  origine      String
  /// Jours apportés par chaque commande : { "FICT-SO-00001": 30 } — retirés si elle est annulée (F06, FR-015).
  apports      Json       @default("{}")
  /// F06 : ouvertures, prolongations, retraits et ajustements [{ date, type, commande?, fin, motif?, auteur? }].
  historique   Json       @default("[]")
  modifieLe    DateTime   @default(now()) @updatedAt
  estFictif    Boolean    @default(true)

  @@map("assistance_right")
}

/// Promotion / code promo (loyalty.program de type promotion).
model Promotion {
  id             Int       @id @default(autoincrement())
  code           String?   @unique
  nom            String
  /// remise_automatique, vente_flash, code_promo
  type           String
  cible          Json      @default("{}")
  remisePourcent Decimal?  @db.Decimal(5, 2)
  remiseCentimes Int?
  debut          DateTime?
  fin            DateTime?
  conditions     Json      @default("{}")
  /// F06 : limites d'usage { usagesMax?, parClient?, montantMinimumCentimes?, nouveauxClients? }.
  limites        Json      @default("{}")
  /// F06 (D6) : code promo annoncé dans le bandeau et sur les fiches.
  annoncee       Boolean   @default(false)
  usages         Int       @default(0)
  cumulable      Boolean   @default(false)
  estFictif      Boolean   @default(true)

  @@map("loyalty_promotion")
}

enum TypeOpportunite {
  financement
  devis
}

/// Opportunité (crm.lead) : copie d'une demande de financement ou de devis du site.
model Opportunite {
  id               Int             @id @default(autoincrement())
  ref              String          @unique
  cle              String          @unique
  type             TypeOpportunite
  partenaireId     Int?
  partenaire       Partenaire?     @relation(fields: [partenaireId], references: [id])
  referenceDemande String
  contenu          Json
  statut           String          @default("nouvelle")
  creeLe           DateTime        @default(now())
  estFictif        Boolean         @default(true)

  @@map("crm_lead")
}

enum EtatAccesCloud {
  a_ouvrir
  a_fermer
  actif
  grace
  suspendu
  ferme
}

/// Accès Cloud simulé par le connecteur PCA de démonstration (F12).
/// F12 : compte du médecin sur la plateforme simulée ; un seul par partenaire (FR-003).
model CompteCloud {
  id           Int          @id @default(autoincrement())
  ref          String       @unique
  partenaireId Int          @unique
  partenaire   Partenaire   @relation(fields: [partenaireId], references: [id])
  email        String
  cabinet      String?
  etat         String       @default("actif")
  creeLe       DateTime     @default(now())
  acces        AccesCloud[]
  estFictif    Boolean      @default(true)

  @@map("cloud_account")
}

model AccesCloud {
  id           Int            @id @default(autoincrement())
  ref          String         @unique
  cle          String?        @unique
  partenaireId Int
  partenaire   Partenaire     @relation(fields: [partenaireId], references: [id])
  compteId     Int?
  compte       CompteCloud?   @relation(fields: [compteId], references: [id])
  logiciel     String
  etat         EtatAccesCloud
  debut        DateTime
  finPrevue    DateTime?
  motif        String?
  modifieLe    DateTime       @updatedAt
  estFictif    Boolean        @default(true)

  @@map("cloud_access")
}

/// Compteur de numérotation continue (factures, commandes).
model Sequence {
  code   String @id
  valeur Int    @default(0)

  @@map("ir_sequence")
}

/// Session de paiement simulée par le connecteur Stripe de démonstration (US7).
model SessionPaiementDemo {
  id                        String   @id
  cle                       String   @unique
  /// paiement ou abonnement
  nature                    String
  commandeRef               String?
  abonnementRef             String?
  partenaireRef             String
  montantTtcCentimes        Int
  montantMensuelTtcCentimes Int?
  moyens                    String[]
  urlRetour                 String
  urlAnnulation             String
  /// ouverte, payee, refusee, authentification
  etat                      String   @default("ouverte")
  paiementRef               String?
  /// F05 : un élément par location [{ element, premierTtc, mensuelTtc, finLe? }] ; autorisation conservée jusqu'au retour.
  elements                  Json     @default("[]")
  autorisationLiberee       Boolean  @default(false)
  creeLe                    DateTime @default(now())
  estFictif                 Boolean  @default(true)

  @@map("payment_session_demo")
}

/// Remboursement simulé (US7).
model RemboursementDemo {
  id                 String   @id
  cle                String   @unique
  paiementRef        String
  montantTtcCentimes Int
  motif              String
  creeLe             DateTime @default(now())
  estFictif          Boolean  @default(true)

  @@map("refund_demo")
}
