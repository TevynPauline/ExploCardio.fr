// Base du site ExploCardio.fr — data-model.md §1 (F11).
// Données propres au site, réelles dès la phase 1. Aucune donnée de patient (principe IV),
// aucune donnée de carte bancaire (principe V).

generator client {
  provider = "prisma-client"
  output   = "../../generated/site"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Comptes et équipe
// Les modèles Utilisateur, Session, CompteConnexion, Verification et DoubleAuthentification
// suivent le schéma attendu par Better Auth (src/lib/auth.ts).
// ---------------------------------------------------------------------------

enum Role {
  client
  admin
  commercial
  support
}

model Utilisateur {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  twoFactorEnabled Boolean? @default(false)
  /// Blocage temporaire après des échecs de connexion répétés (F02).
  bloqueJusqua     DateTime?

  prenom     String?
  nom        String?
  civilite   String?
  telephone  String?
  specialite String?
  role       Role    @default(client)

  sessions       Session[]
  comptes        CompteConnexion[]
  doubleAuth     DoubleAuthentification[]
  compteClient   CompteClient?
  historiques    HistoriqueParametre[]

  @@map("utilisateur")
}

model Session {
  id        String      @id
  expiresAt DateTime
  token     String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Moyen de connexion (mot de passe haché par Better Auth).
model CompteConnexion {
  id                    String      @id
  accountId             String
  providerId            String
  userId                String
  user                  Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@map("compte_connexion")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model DoubleAuthentification {
  id                      String      @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?    @default(true)
  failedVerificationCount Int?        @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("double_authentification")
}

enum TypeCompteClient {
  medecin
  structure
}

enum StatutCompteClient {
  email_a_confirmer
  en_attente
  valide
  refuse
  suspendu
  supprime
}

model CompteClient {
  id                 String             @id @default(cuid())
  utilisateurId      String             @unique
  utilisateur        Utilisateur        @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type               TypeCompteClient
  /// Un RPPS par compte (F02, FR-004). Un SIRET peut être partagé par plusieurs comptes.
  rpps               String?            @unique
  siret              String?
  nomCabinet         String?
  statut             StatutCompteClient @default(email_a_confirmer)
  motifRefus         String?
  /// Identifiant du partenaire dans Odoo, rempli à la validation par le connecteur.
  odooPartnerRef     String?
  /// Compte de démonstration (FR-041) : recréé à chaque réinitialisation.
  estDemonstration   Boolean            @default(false)
  creeLe             DateTime           @default(now())
  modifieLe          DateTime           @updatedAt
  valideLe           DateTime?

  adresses           Adresse[]
  demandesFinancement DemandeFinancement[]
  decisions          DecisionCompte[]
  attribution        AttributionCadeau[]
  demandesNumero     DemandeChangementNumero[]
  demandesRgpd       DemandeRgpd[]

  @@index([siret])
  @@index([statut])
  @@map("compte_client")
}

enum TypeAdresse {
  cabinet
  livraison
  facturation
}

model Adresse {
  id         String       @id @default(cuid())
  compteId   String
  compte     CompteClient @relation(fields: [compteId], references: [id], onDelete: Cascade)
  type       TypeAdresse
  ligne1     String
  ligne2     String?
  codePostal String
  ville      String

  @@index([compteId])
  @@map("adresse")
}

/// Historique des consentements : jamais écrasé (RGPD).
model Consentement {
  id          String   @id @default(cuid())
  compteId    String?
  email       String?
  objet       String
  etat        Boolean
  date        DateTime @default(now())
  origine     String
  textePresente String

  @@index([compteId])
  @@index([email])
  @@map("consentement")
}

// ---------------------------------------------------------------------------
// Contenus et paramètres
// ---------------------------------------------------------------------------

enum TypeContenu {
  bandeau
  tuile
  actualite
  page
  faq
  tutoriel
  notice
}

enum EtatPublication {
  preparation
  publie
  retire
}

model Contenu {
  id        String          @id @default(cuid())
  type      TypeContenu
  titre     String
  corps     String
  /// Images : [{ url, texteRemplacement }] — texte de remplacement obligatoire.
  images    Json            @default("[]")
  etat      EtatPublication @default(preparation)
  debut     DateTime?
  fin       DateTime?
  /// Chemin interne (/…) ou adresse https:// (vérifié à l'enregistrement).
  lien      String?
  ordre     Int             @default(0)
  /// Ex. « En préparation » (F01, FR-021).
  badge     String?
  /// Encart doux de la charte : pale, blue-soft, lin, mint (tuiles).
  fond      String?
  typeActualite TypeActualite?
  publieLe  DateTime?
  creeLe    DateTime        @default(now())
  modifieLe DateTime        @updatedAt

  @@index([type, etat])
  @@map("contenu")
}

enum TypeActualite {
  actualite
  nouveau_produit
  nouvelle_offre
}

// ---------------------------------------------------------------------------
// F01 — Marques, méga-menus, newsletter, limites d'envoi
// ---------------------------------------------------------------------------

/// Marque partenaire affichée sur l'accueil (FR-019) : contenu éditorial du site.
model Marque {
  id       String   @id @default(cuid())
  nom      String   @unique
  /// Chemin du logo dans le stockage (STORAGE_DIR), facultatif.
  logo     String?
  /// holter-ecg, mapa, effort
  familles String[] @default([])
  ordre    Int      @default(0)
  visible  Boolean  @default(true)
  modifieLe DateTime @updatedAt

  @@map("marque")
}

enum EntreeMenu {
  holter_ecg
  holter_tensionnel
  epreuve_effort
  accessoires
  services
  financement
  qui_sommes_nous
}

enum TypeElementMenu {
  produit_phare
  lien_rapide
}

/// Produit phare ou lien rapide d'un méga-menu, choisi par l'administrateur.
model ElementMenu {
  id          String          @id @default(cuid())
  entree      EntreeMenu
  type        TypeElementMenu
  /// Référence d'article d'Odoo (produit phare).
  defaultCode String?
  libelle     String?
  lien        String?
  ordre       Int             @default(0)

  @@index([entree, type])
  @@map("element_menu")
}

enum EtatNewsletter {
  en_attente
  confirmee
  desinscrite
  expiree
}

/// Inscription à la newsletter à double consentement (FR-028).
model InscriptionNewsletter {
  id             String         @id @default(cuid())
  email          String         @unique
  etat           EtatNewsletter @default(en_attente)
  /// Empreinte du jeton de confirmation ou de désinscription (jamais le jeton lui-même).
  empreinteJeton String?        @unique
  demandeeLe     DateTime       @default(now())
  confirmeeLe    DateTime?
  desinscriteLe  DateTime?
  textePresente  String

  @@map("inscription_newsletter")
}

/// Limite d'envois par empreinte d'adresse (FR-032), fenêtre d'une heure.
model LimiteEnvoi {
  cle          String   @id
  fenetreDebut DateTime
  compte       Int      @default(0)

  @@map("limite_envoi")
}

/// Contenu éditorial d'un article d'Odoo, rattaché par sa référence, jamais par copie.
model ContenuProduit {
  id              String          @id @default(cuid())
  defaultCode     String          @unique
  textes          Json            @default("{}")
  photos          Json            @default("[]")
  documents       Json            @default("[]")
  compatibilites  String[]        @default([])
  produitsAssocies String[]       @default([])
  categorieAffichage String?
  ordre           Int             @default(0)
  etat            EtatPublication @default(preparation)
  orphelin        Boolean         @default(false)
  modifieLe       DateTime        @updatedAt

  @@map("contenu_produit")
}

/// Paramètre de fonctionnement du site (principe VI) — jamais une règle commerciale.
model Parametre {
  cle             String                @id
  valeur          String
  type            String                @default("texte")
  roleModification Role                 @default(admin)
  modifieLe       DateTime              @updatedAt
  historique      HistoriqueParametre[]

  @@map("parametre")
}

model HistoriqueParametre {
  id             String       @id @default(cuid())
  cle            String
  parametre      Parametre    @relation(fields: [cle], references: [cle], onDelete: Cascade)
  auteurId       String?
  auteur         Utilisateur? @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  date           DateTime     @default(now())
  ancienneValeur String?
  nouvelleValeur String

  @@index([cle])
  @@map("historique_parametre")
}

// ---------------------------------------------------------------------------
// Demandes et messages
// ---------------------------------------------------------------------------

enum StatutDemandeFinancement {
  recue
  en_etude
  accordee
  refusee
}

model DemandeFinancement {
  id               String                   @id @default(cuid())
  compteId         String
  compte           CompteClient             @relation(fields: [compteId], references: [id], onDelete: Cascade)
  equipements      Json
  dureeMois        Int
  statut           StatutDemandeFinancement @default(recue)
  notesInternes    String?
  opportuniteRef   String?
  creeLe           DateTime                 @default(now())

  @@map("demande_financement")
}

enum StatutDemandeDevis {
  recue
  en_cours
  traitee
}

model DemandeDevis {
  id             String             @id @default(cuid())
  demandeur      Json
  objet          String
  statut         StatutDemandeDevis @default(recue)
  notes          String?
  opportuniteRef String?
  creeLe         DateTime           @default(now())

  @@map("demande_devis")
}

model MessageContact {
  id           String   @id @default(cuid())
  motif        String
  coordonnees  Json
  texte        String
  date         DateTime @default(now())
  etat         String   @default("nouveau")

  @@map("message_contact")
}

// ---------------------------------------------------------------------------
// Exploitation et démonstration
// ---------------------------------------------------------------------------

model JournalConnecteur {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  connecteur  String
  mode        String
  operation   String
  objet       String?
  resultat    String
  /// Niveau : info, erreur ou alerte (seuil d'échecs de la file d'attente).
  niveau      String   @default("info")
  motifErreur String?
  dureeMs     Int

  @@index([date])
  @@index([connecteur, date])
  @@map("journal_connecteur")
}

model JournalAction {
  id       String   @id @default(cuid())
  auteurId String?
  /// Libellé lisible de l'auteur (ex. « équipe technique (commande) »).
  auteur   String
  action   String
  objet    String?
  date     DateTime @default(now())
  detail   Json?

  @@index([date])
  @@map("journal_action")
}

model EvenementPaiementTraite {
  id     String   @id
  type   String
  date   DateTime @default(now())

  @@map("evenement_paiement_traite")
}

enum TypeMessageDemonstration {
  email_client
  notification_equipe_email
  notification_equipe_sms
}

model MessageDemonstration {
  id           String                   @id @default(cuid())
  type         TypeMessageDemonstration
  destinataire String
  objet        String
  rendu        String
  date         DateTime                 @default(now())
  declencheur  String
  etatRemise   String                   @default("remis")
  /// Clé d'idempotence : rejouer le même envoi n'ajoute rien.
  cle          String                   @unique

  @@index([date])
  @@map("message_demonstration")
}

model PanneSimulee {
  connecteur String   @id
  active     Boolean  @default(false)
  date       DateTime @updatedAt

  @@map("panne_simulee")
}

// ---------------------------------------------------------------------------
// F02 — Comptes professionnels
// ---------------------------------------------------------------------------

enum TypeDecision {
  validation
  refus
  suspension
  retablissement
}

/// Décision de l'équipe sur un compte (FR-012, FR-016).
model DecisionCompte {
  id       String       @id @default(cuid())
  compteId String
  compte   CompteClient @relation(fields: [compteId], references: [id], onDelete: Cascade)
  decision TypeDecision
  motif    String?
  /// Vide pour une validation automatique.
  auteurId String?
  date     DateTime     @default(now())

  @@index([compteId])
  @@map("decision_compte")
}

enum EtatCadeau {
  droit_ouvert
  en_attente_stock
  remis
}

/// Droit au tensiomètre de bienvenue : un seul par numéro RPPS ou SIRET (FR-019, SC-002).
model AttributionCadeau {
  id          String       @id @default(cuid())
  numero      String       @unique
  compteId    String?
  compte      CompteClient? @relation(fields: [compteId], references: [id], onDelete: SetNull)
  etat        EtatCadeau   @default(droit_ouvert)
  ouvertLe    DateTime     @default(now())
  remisLe     DateTime?
  commandeRef String?

  @@map("attribution_cadeau")
}

enum EtatDemandeNumero {
  en_attente
  acceptee
  refusee
}

/// Changement de RPPS ou SIRET demandé depuis « Mon compte » : vérifié par l'équipe (FR-037).
model DemandeChangementNumero {
  id            String            @id @default(cuid())
  compteId      String
  compte        CompteClient      @relation(fields: [compteId], references: [id], onDelete: Cascade)
  ancienNumero  String?
  nouveauNumero String
  etat          EtatDemandeNumero @default(en_attente)
  motif         String?
  traiteePar    String?
  demandeeLe    DateTime          @default(now())
  traiteeLe     DateTime?

  @@index([etat])
  @@map("demande_changement_numero")
}

/// Échecs de connexion par compte (empreinte de l'email, jamais l'email en clair).
model EchecConnexion {
  cle          String   @id
  premierEchec DateTime
  compte       Int      @default(0)

  @@map("echec_connexion")
}

enum TypeDemandeRgpd {
  export
  suppression
}

enum EtatDemandeRgpd {
  recue
  traitee
  refusee
}

/// Demande d'export ou de suppression des données (FR-039 à FR-041).
model DemandeRgpd {
  id        String          @id @default(cuid())
  compteId  String?
  compte    CompteClient?   @relation(fields: [compteId], references: [id], onDelete: SetNull)
  type      TypeDemandeRgpd
  etat      EtatDemandeRgpd @default(recue)
  motif     String?
  origine   String          @default("mon_compte")
  recueLe   DateTime        @default(now())
  traiteeLe DateTime?

  @@index([etat])
  @@map("demande_rgpd")
}
